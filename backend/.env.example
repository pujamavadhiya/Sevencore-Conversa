# ==============================================================================
# VaaniFlow Backend Configuration
# ==============================================================================
# Central Brand Identifier: VaaniFlow
APP_NAME=VaaniFlow
APP_ENV=development

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# In local development without Postgres, leave empty to automatically fallback to SQLite.
# In production on Render/AWS, provide your managed PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/vaaniflow
DATABASE_URL=

# Frontend and CORS Origins
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Sarvam AI Voice Agents & Rented Telephony Credentials
# ==============================================================================
# Obtain from Sarvam Dashboard: https://dashboard.sarvam.ai/
# In local dev without credentials, set SARVAM_USE_MOCK=True to simulate calls safely.
SARVAM_USE_MOCK=True
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://apps.sarvam.ai
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# Sarvam-rented Phone Number Details (from Sarvam Dashboard -> Deploy -> Phone Numbers)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_DEFAULT_APP_ID=
SARVAM_DEFAULT_APP_VERSION=1

# Webhook Secret for callback validation
SARVAM_WEBHOOK_SECRET=

# Background Campaign Processing
# Redis URL for production Celery worker (e.g. redis://localhost:6379/0)
REDIS_URL=

# Telecom & Compliance Guardrails (TRAI / India)
# Permitted calling window hours (IST: 24h format, default 9 to 20 is 09:00 - 20:00)
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=20
MAX_CALLS_PER_SECOND=2
DEFAULT_MAX_RETRIES=2
