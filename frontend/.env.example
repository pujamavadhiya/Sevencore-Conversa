# VaaniFlow Frontend Public & Server Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=VaaniFlow

# Sarvam AI Instant Outbound Credentials (Server-side Next.js route handlers)
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://apps.sarvam.ai
SARVAM_OUTBOUND_API_BASE=https://apps.sarvam.ai/api/outbounds
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_DEFAULT_APP_ID=agent_sales_v1
SARVAM_DEFAULT_APP_VERSION=1
SARVAM_WEBHOOK_SECRET=
SARVAM_WEBHOOK_URL=http://localhost:3000/api/sarvam/webhook

# Compliance & Telephony Guardrails
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=20
SARVAM_MAX_ATTEMPTS=3
SARVAM_RETRY_DELAYS_SEC=900,3600
HTTP_TIMEOUT_SECONDS=15
WEBHOOK_WATCHDOG_SECONDS=1200
TIME_ZONE=Asia/Kolkata
